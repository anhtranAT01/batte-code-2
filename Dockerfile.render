FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 git openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/package*.json ./backend/
COPY judge-worker/package*.json ./judge-worker/
RUN cd backend && npm ci \
    && cd ../judge-worker && npm ci --omit=dev

COPY backend ./backend
COPY judge-worker ./judge-worker
COPY scripts ./scripts
COPY sample-bots ./sample-bots

RUN cd backend && npx prisma generate

ENV NODE_ENV=production
ENV PORT=10000
ENV BOT_STORAGE_ROOT=/var/data/bots

EXPOSE 10000

CMD ["node", "scripts/render-start.js"]
