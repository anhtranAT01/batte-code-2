{
  "name": "rps-tactical-backend",
  "version": "1.0.0",
  "description": "Tactical Rock-Paper-Scissors Arena Backend Server with Real-time WebSockets and BullMQ",
  "main": "src/server.js",
  "scripts": {
    "test:replay-retention": "node src/admin/testReplayRetention.js",
    "test:standings-performance": "node src/tournament/testStandingsPerformance.js",
    "test:resilience": "node src/support/testSupport.js",
    "test:submission-capacity": "node src/support/testSubmissionCapacity.js",
    "test:realtime": "node src/realtime/testOnlineCount.js",
    "test:recovery-email": "node src/auth/testRecoveryEmailProviders.js",
    "test:tournament-teams": "node src/tournament/testTournamentTeam.js",
    "test:match-numbers": "node src/game/testMatchNumbers.js && node src/game/testMatchNumberMigration.js",
    "test:performance": "node src/game/testSearchSimulation.js && node src/game/testArenaReads.js && node src/game/testDuelExecutor.js && node src/game/testDuelResponse.js",
    "test:admin-accounts": "node src/admin/testAdminAccounts.js",
    "test:admin-deletions": "node src/admin/testAdminDeletions.js",
    "test:heuristic-file": "node src/game/testHeuristicPython.js",
    "test:admin-registration": "node src/auth/testAdminRegistration.js",
    "test:history": "node src/game/testMatchHistory.js",
    "test:pvp": "node src/game/testPvPOwnership.js",
    "test:bot-uploads": "node src/bot/testBotUploads.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:practice": "node src/game/testPracticeBots.js && node src/game/testAutomatedBots.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed": "node src/scripts/seedAdmin.js"
  },
  "keywords": [
    "rock-paper-scissors",
    "board-game",
    "ai-arena",
    "socket.io",
    "bullmq",
    "postgresql",
    "redis"
  ],
  "author": "Tactical RPS Arena Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0"
  }
}
