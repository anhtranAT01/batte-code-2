NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://rps_admin:rps_secret_password_2026@localhost:5432/rps_arena?schema=public"

# Redis Connection Details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=rps_redis_password_2026

# JWT Authentication Config
JWT_SECRET=super_secret_jwt_key_tactical_rps_2026_x892k
JWT_EXPIRES_IN=7d

# CORS and Security
CORS_ORIGIN=*

# Cloudflare Tunnel Token (optional for local dev)
CLOUDFLARE_TUNNEL_TOKEN=

# Default Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Admin signup stays disabled until this server-only secret is configured.
ADMIN_REGISTRATION_SECRET=

# Optional absolute Python executable path; otherwise python3 (Linux) / python (Windows).
PYTHON_EXECUTABLE=

# Password recovery email (recommended: Resend HTTPS API; never commit real keys)
RESEND_API_KEY=
EMAIL_FROM=BattleCode <no-reply@your-verified-domain.example>
PASSWORD_RESET_URL=http://localhost:5173/

# Optional SMTP fallback when RESEND_API_KEY is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
